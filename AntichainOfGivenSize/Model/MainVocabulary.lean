import AntichainOfGivenSize.Model.CountingVocabulary
import Mathlib.Analysis.SpecialFunctions.Log.Base
import Mathlib.Data.Finset.Lattice.Fold
import Mathlib.Order.Lattice.Nat

/-!
# Vocabulary underlying the minimum-generator asymptotics

Only definitions reached by Theorem 1.1 are relocated here. Their qualified
names and bodies are unchanged; the original modules import this vocabulary.
The scale is interpreted on real inputs greater than four. Density counts
include the cutoff, whereas the extremal maximum uses a strict cutoff.
-/

namespace AntichainOfGivenSize

/-- `HasGeneratorCount n k` means that an ideal with exactly `n` members is
generated by exactly `k` sets.

The finite type `Fin m` is a canonical ambient universe. Every finite family
of finite sets can be relabelled inside one of these universes. This
implementation-facing predicate permits redundant generators. -/
def HasGeneratorCount (n k : ℕ) : Prop :=
  ∃ m : ℕ, ∃ generators : Finset (Finset (Fin m)),
    (generatedIdeal generators).card = n ∧ generators.card = k

/-- `α(n)`, the minimum number of generators of an ideal with `n` members.

`mainAlphaHasAntichainWitness` certifies that this unrestricted minimum is
attained by an inclusion antichain, and hence agrees with the paper's
generating-antichain definition. -/
noncomputable def alpha (n : ℕ) : ℕ :=
  sInf {k : ℕ | HasGeneratorCount n k}

/-- The scale occurring in both main bounds:
`(log₂(log₂ n))² / log₂(log₂(log₂ n))`. -/
noncomputable def quadraticLogLogScale (n : ℝ) : ℝ :=
  (Real.logb 2 (Real.logb 2 n)) ^ 2 /
    Real.logb 2 (Real.logb 2 (Real.logb 2 n))

namespace Paper

/-- The simultaneous good inputs, for the literal proportion formulation. -/
noncomputable def goodInputs (c C : ℝ) (X : ℕ) : Finset ℕ :=
  (Finset.Icc 5 X).filter fun n ↦
    c * quadraticLogLogScale (n : ℝ) ≤ (alpha n : ℝ) ∧
      (alpha n : ℝ) ≤ C * quadraticLogLogScale (n : ℝ)

/-- The integers satisfying both bounds and `5 ≤ n ≤ X`. -/
noncomputable def realGoodInputs (c C X : ℝ) : Finset ℕ :=
  goodInputs c C ⌊X⌋₊

/-- The exact maximum over positive integers strictly below a real cutoff. -/
noncomputable def maximumBelow (X : ℝ) : ℕ :=
  (Finset.Ico 1 ⌈X⌉₊).sup alpha

end Paper

end AntichainOfGivenSize
