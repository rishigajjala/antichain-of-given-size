/-! ## Former CountingVocabulary module -/
section

/-!
# Vocabulary underlying the attainable-size count

These are the existing finite-profile definitions, relocated without changing
their qualified names or mathematical contents. Keeping their full defining
chain here makes `Paper.attainableValues` readable within the Model audit
surface. The original Section6, LowerBound and Paper modules import this
vocabulary and retain their proofs.
-/

open scoped BigOperators

/-! ## Vocabulary -/

namespace AntichainOfGivenSize

/-- The ideal generated by a finite family `S`:
`ID(S) = ⋃ A ∈ S, 2^A`. -/
def generatedIdeal {V : Type*} [DecidableEq V]
    (generators : Finset (Finset V)) : Finset (Finset V) :=
  generators.biUnion fun generator ↦ generator.powerset

end AntichainOfGivenSize

namespace AntichainOfGivenSize.Section6

variable {ι V : Type*} [DecidableEq V]

/-- The ideal generated by a finitely indexed family. Keeping the index set
separate is useful during the block construction; repeated generators are
discarded only when the family is converted to the paper's set-valued model. -/
def generatedIdealIdx (s : Finset ι) (G : ι → Finset V) : Finset (Finset V) :=
  s.biUnion fun i ↦ (G i).powerset

end AntichainOfGivenSize.Section6

namespace AntichainOfGivenSize.VennProfile

variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Canonical ground-set elements realizing the multiplicities `x`. -/
def ProfilePoint (x : Finset I → ℕ) := Σ A : Finset I, Fin (x A)

instance (x : Finset I → ℕ) : Fintype (ProfilePoint x) :=
  Sigma.instFintype

noncomputable instance (x : Finset I → ℕ) : DecidableEq (ProfilePoint x) :=
  Classical.decEq _

/-- The canonical generator indexed by `i` contains precisely the profile
points whose patterns contain `i`. -/
noncomputable def profileGenerator (x : Finset I → ℕ) (i : I) :
    Finset (ProfilePoint x) :=
  Finset.univ.filter fun p ↦ i ∈ p.1

end AntichainOfGivenSize.VennProfile

namespace AntichainOfGivenSize.ClusterLowerBound

/-- The natural-valued multiplicity function underlying a finite profile. -/
def atomMultiplicity {K B : ℕ}
    (x : Finset (Fin K) → Fin (B + 1)) (A : Finset (Fin K)) : ℕ :=
  (x A).1

/-- Load of generator `i` in a finite Venn profile. -/
def profileLoad {K B : ℕ}
    (x : Finset (Fin K) → Fin (B + 1)) (i : Fin K) : ℕ :=
  ∑ A ∈ Finset.univ.powerset.filter (fun A : Finset (Fin K) ↦ i ∈ A),
    atomMultiplicity x A

/-- A finite Venn profile with `K` labelled generators and maximum load `B`.

The empty-pattern multiplicity is normalized to zero because points outside
all generators do not affect the generated ideal. -/
structure BoundedProfile (K B : ℕ) where
  atom : Finset (Fin K) → Fin (B + 1)
  empty_zero : atom ∅ = 0
  load_le : ∀ i : Fin K, profileLoad atom i ≤ B

noncomputable instance (K B : ℕ) : Fintype (BoundedProfile K B) :=
  Fintype.ofInjective BoundedProfile.atom
    (fun ⟨_, _, _⟩ ⟨_, _, _⟩ h ↦ (BoundedProfile.mk.injEq ..).mpr h)

noncomputable instance (K B : ℕ) : DecidableEq (BoundedProfile K B) :=
  Classical.decEq _

/-- The natural-valued Venn multiplicities of a bounded profile. -/
def BoundedProfile.toNatProfile {K B : ℕ} (x : BoundedProfile K B) :
    Finset (Fin K) → ℕ :=
  atomMultiplicity x.atom

/-- Cardinality of the canonical ideal represented by a bounded profile. -/
noncomputable def BoundedProfile.value {K B : ℕ}
    (x : BoundedProfile K B) : ℕ :=
  (Section6.generatedIdealIdx Finset.univ
    (VennProfile.profileGenerator x.toNatProfile)).card

end AntichainOfGivenSize.ClusterLowerBound

/-! ## The quantity -/

namespace AntichainOfGivenSize.ClusterLowerBound

/-- Exact natural values represented by bounded `K`-profiles. -/
noncomputable def boundedValues (K B : ℕ) : Finset ℕ :=
  (Finset.univ : Finset (BoundedProfile K B)).image BoundedProfile.value

end AntichainOfGivenSize.ClusterLowerBound

namespace AntichainOfGivenSize.Paper

/-- The paper's ideal sizes with at most `K` nonempty-indexed generators,
each of size at most `B`. For `K > 0`, padding by repetition identifies this
with the exact-`K` bounded-profile image. The representation equivalence is
proved separately; this finite implementation includes no ambient-size cap. -/
noncomputable def attainableValues (B K : ℕ) : Finset ℕ :=
  ClusterLowerBound.boundedValues K B

end AntichainOfGivenSize.Paper

end

/-! ## Former MainVocabulary module -/
section

/-!
# Vocabulary underlying the minimum-generator asymptotics

Only definitions reached by Theorem 1.1 are relocated here. Their qualified
names and bodies are unchanged; the original modules import this vocabulary.
The scale is interpreted on real inputs greater than four. Density counts
include the cutoff, whereas the extremal maximum uses a strict cutoff.
-/

namespace AntichainOfGivenSize

/-- `HasGeneratorCount n k` means that an ideal with exactly `n` members is
generated by exactly `k` sets.

The finite type `Fin m` is a canonical ambient universe. Every finite family
of finite sets can be relabelled inside one of these universes. This
implementation-facing predicate permits redundant generators. -/
def HasGeneratorCount (n k : ℕ) : Prop :=
  ∃ m : ℕ, ∃ generators : Finset (Finset (Fin m)),
    (generatedIdeal generators).card = n ∧ generators.card = k

/-- `α(n)`, the minimum number of generators of an ideal with `n` members.

`mainAlphaHasAntichainWitness` certifies that this unrestricted minimum is
attained by an inclusion antichain, and hence agrees with the paper's
generating-antichain definition. -/
noncomputable def alpha (n : ℕ) : ℕ :=
  sInf {k : ℕ | HasGeneratorCount n k}

/-- The scale occurring in both main bounds:
`(log₂(log₂ n))² / log₂(log₂(log₂ n))`. -/
noncomputable def quadraticLogLogScale (n : ℝ) : ℝ :=
  (Real.logb 2 (Real.logb 2 n)) ^ 2 /
    Real.logb 2 (Real.logb 2 (Real.logb 2 n))

namespace Paper

/-- The simultaneous good inputs, for the literal proportion formulation. -/
noncomputable def goodInputs (c C : ℝ) (X : ℕ) : Finset ℕ :=
  (Finset.Icc 5 X).filter fun n ↦
    c * quadraticLogLogScale (n : ℝ) ≤ (alpha n : ℝ) ∧
      (alpha n : ℝ) ≤ C * quadraticLogLogScale (n : ℝ)

/-- The integers satisfying both bounds and `5 ≤ n ≤ X`. -/
noncomputable def realGoodInputs (c C X : ℝ) : Finset ℕ :=
  goodInputs c C ⌊X⌋₊

/-- The exact maximum over positive integers strictly below a real cutoff. -/
noncomputable def maximumBelow (X : ℝ) : ℕ :=
  (Finset.Ico 1 ⌈X⌉₊).sup alpha

end Paper

end AntichainOfGivenSize

end

/-! ## Former ProbabilityVocabulary module -/
section

namespace AntichainOfGivenSize.Paper

/-- Uniform sampling of a natural number from the paper's half-open dyadic block.
The positive index supplies a nonempty sample space. -/
noncomputable def dyadicUniformPMF (B : ℕ) (hB : 1 ≤ B) : PMF ℕ :=
  PMF.uniformOfFinset (Finset.Ico (2 ^ (B - 1)) (2 ^ B))
    (Finset.nonempty_Ico.mpr
      (Nat.pow_lt_pow_right (by decide : 1 < (2 : ℕ)) (by omega : B - 1 < B)))

end AntichainOfGivenSize.Paper

end

/-! ## Former BitMatchingVocabulary module -/
section

/-!
# Bit-matching construction vocabulary

The original binary addresses, vertices and generators, with their existing
qualified names and defining bodies. Their proofs remain in Paper/BitMatching.
-/

open scoped BigOperators
open Finset

namespace AntichainOfGivenSize.Paper.BitMatching

open AntichainOfGivenSize.Section6

abbrev Index (q : ℕ) := Fin q × Bool

abbrev Stage (q : ℕ) := Fin (2 ^ q)

abbrev BlockVertex (q : ℕ) := (j : Fin q) × Fin (2 ^ j.val)

abbrev Vertex (q : ℕ) := BlockVertex q ⊕ (Fin q ⊕ Stage q)

def chosenIndex {q : ℕ} (i : Stage q) (j : Fin q) : Index q :=
  (j, i.val.testBit j.val)

def chosenEmbedding {q : ℕ} (i : Stage q) : Fin q ↪ Index q where
  toFun := chosenIndex i
  inj' := by intro j k h; exact congrArg Prod.fst h

def address {q : ℕ} (i : Stage q) : Finset (Index q) :=
  Finset.univ.map (chosenEmbedding i)

def Present {q : ℕ} (active : Finset (Stage q)) (p : Index q) : Vertex q → Prop
  | Sum.inl e => e.1 ≠ p.1 ∨ p.2 = true
  | Sum.inr (Sum.inl j) => j ≠ p.1
  | Sum.inr (Sum.inr g) => g ∈ active ∧ p.2 = g.val.testBit p.1.val

noncomputable def generator {q : ℕ} (active : Finset (Stage q))
    (p : Index q) : Finset (Vertex q) := by
  classical
  exact Finset.univ.filter (Present active p)

noncomputable def intersection {q : ℕ} (active : Finset (Stage q))
    (J : Finset (Index q)) : Finset (Vertex q) := by
  classical
  exact Finset.univ.filter fun v => ∀ p ∈ J, Present active p v

def blockEmbedding {q : ℕ} (j : Fin q) : Fin (2 ^ j.val) ↪ Vertex q where
  toFun x := Sum.inl ⟨j,x⟩
  inj' := by intro x y h; simpa using h

noncomputable def block {q : ℕ} (j : Fin q) : Finset (Vertex q) :=
  Finset.univ.map (blockEmbedding j)

noncomputable def core {q : ℕ} (i : Stage q) : Finset (Vertex q) :=
  (Finset.univ.filter fun j : Fin q => i.val.testBit j.val = true).biUnion block

end AntichainOfGivenSize.Paper.BitMatching

end

/-! ## Former PatternGadgetVocabulary module -/
section

/-!
# Pattern-gadget construction vocabulary

The original tagged generators and digit selection used by Claim 6.2.
Their qualified names and defining bodies are unchanged.
-/

open Finset

namespace AntichainOfGivenSize.Paper.PatternGadget

abbrev Vertex (ell : ℕ) := Fin ell ⊕ Fin ell

abbrev Index (ell : ℕ) := Option (Fin ell)

def baseline (ell : ℕ) : Finset (Vertex ell) :=
  Finset.univ.map Function.Embedding.inl

def initialSegment {ell : ℕ} (a : Fin ell) : Finset (Vertex ell) :=
  (Finset.Iio a).map Function.Embedding.inl

def generator {ell : ℕ} : Index ell → Finset (Vertex ell)
  | none => baseline ell
  | some a => insert (Sum.inr a) (initialSegment a)

def selected {ell : ℕ} (D : Finset (Fin ell)) : Finset (Index ell) :=
  insert none (D.image some)

def selectedBits (ell d : ℕ) : Finset (Fin ell) :=
  Finset.univ.filter fun a ↦ d.testBit a.val

end AntichainOfGivenSize.Paper.PatternGadget

end

/-! ## Former UpperConstructionVocabulary module -/
section

/-!
# Block-matching construction vocabulary

The original position and pattern generators, their ideal cardinality and
selected digits. Geometry, increment and size proofs remain in Paper/.
-/

open Finset
open scoped BigOperators

namespace AntichainOfGivenSize.Paper.UpperConstruction

open AntichainOfGivenSize.Section6

abbrev Index (r : ℕ) (K : Type*) := BitMatching.Index r ⊕ K

abbrev Vertex (r ell : ℕ) (V : Type*) := (BitMatching.Vertex r × Fin ell) ⊕ (V ⊕ BitMatching.Stage r)

noncomputable def oldUniverse (r : ℕ) : Finset (BitMatching.Vertex r) :=
  Finset.univ.disjSum (Finset.univ.disjSum ∅)

def selected {r : ℕ} {K : Type*} (i : BitMatching.Stage r) (D : Finset K) :
    Finset (Index r K) := (BitMatching.address i).disjSum D

noncomputable def Present {r ell : ℕ} {K V : Type*} [DecidableEq V]
    (active : Finset (BitMatching.Stage r)) (hist : BitMatching.Stage r → Finset K) (R : K → Finset V) :
    Index r K → Vertex r ell V → Prop
  | Sum.inl p, Sum.inl u => u.1 ∈ BitMatching.generator ∅ p
  | Sum.inr _, Sum.inl u => u.1 ∈ oldUniverse r
  | Sum.inl _, Sum.inr (Sum.inl _) => True
  | Sum.inr k, Sum.inr (Sum.inl v) => v ∈ R k
  | p, Sum.inr (Sum.inr g) => g ∈ active ∧ p ∈ selected g (hist g)

noncomputable def generator {r ell : ℕ} {K V : Type*} [Fintype V] [DecidableEq V]
    (active : Finset (BitMatching.Stage r)) (hist : BitMatching.Stage r → Finset K) (R : K → Finset V)
    (p : Index r K) : Finset (Vertex r ell V) := by
  classical
  exact Finset.univ.filter (Present active hist R p)

noncomputable def idealCard {r ell : ℕ} {K V : Type*}
    [Fintype K] [DecidableEq K] [Fintype V] [DecidableEq V]
    (active : Finset (BitMatching.Stage r)) (hist : BitMatching.Stage r → Finset K)
    (R : K → Finset V) : ℕ :=
  (generatedIdealIdx Finset.univ (generator (ell := ell) active hist R)).card

def digitSelection (ell d : ℕ) : Finset (PatternGadget.Index ell) :=
  PatternGadget.selected (PatternGadget.selectedBits ell d)

end AntichainOfGivenSize.Paper.UpperConstruction

end
