import Mathlib.Algebra.BigOperators.Group.Finset.Defs
import Mathlib.Data.Fintype.Pi
import Mathlib.Data.Fintype.Powerset
import Mathlib.Data.Fintype.Sigma

/-!
# Vocabulary underlying the attainable-size count

These are the existing finite-profile definitions, relocated without changing
their qualified names or mathematical contents. Keeping their full defining
chain here makes `Paper.attainableValues` readable within the Model audit
surface. The original Section6, LowerBound and Paper modules import this
vocabulary and retain their proofs.
-/

open scoped BigOperators

/-! ## Vocabulary -/

namespace AntichainOfGivenSize

/-- The ideal generated by a finite family `S`:
`ID(S) = ⋃ A ∈ S, 2^A`. -/
def generatedIdeal {V : Type*} [DecidableEq V]
    (generators : Finset (Finset V)) : Finset (Finset V) :=
  generators.biUnion fun generator ↦ generator.powerset

end AntichainOfGivenSize

namespace AntichainOfGivenSize.Section6

variable {ι V : Type*} [DecidableEq V]

/-- The ideal generated by a finitely indexed family. Keeping the index set
separate is useful during the block construction; repeated generators are
discarded only when the family is converted to the paper's set-valued model. -/
def generatedIdealIdx (s : Finset ι) (G : ι → Finset V) : Finset (Finset V) :=
  s.biUnion fun i ↦ (G i).powerset

end AntichainOfGivenSize.Section6

namespace AntichainOfGivenSize.VennProfile

variable {I : Type*} [Fintype I] [DecidableEq I]

/-- Canonical ground-set elements realizing the multiplicities `x`. -/
def ProfilePoint (x : Finset I → ℕ) := Σ A : Finset I, Fin (x A)

instance (x : Finset I → ℕ) : Fintype (ProfilePoint x) :=
  Sigma.instFintype

noncomputable instance (x : Finset I → ℕ) : DecidableEq (ProfilePoint x) :=
  Classical.decEq _

/-- The canonical generator indexed by `i` contains precisely the profile
points whose patterns contain `i`. -/
noncomputable def profileGenerator (x : Finset I → ℕ) (i : I) :
    Finset (ProfilePoint x) :=
  Finset.univ.filter fun p ↦ i ∈ p.1

end AntichainOfGivenSize.VennProfile

namespace AntichainOfGivenSize.ClusterLowerBound

/-- The natural-valued multiplicity function underlying a finite profile. -/
def atomMultiplicity {K B : ℕ}
    (x : Finset (Fin K) → Fin (B + 1)) (A : Finset (Fin K)) : ℕ :=
  (x A).1

/-- Load of generator `i` in a finite Venn profile. -/
def profileLoad {K B : ℕ}
    (x : Finset (Fin K) → Fin (B + 1)) (i : Fin K) : ℕ :=
  ∑ A ∈ Finset.univ.powerset.filter (fun A : Finset (Fin K) ↦ i ∈ A),
    atomMultiplicity x A

/-- A finite Venn profile with `K` labelled generators and maximum load `B`.

The empty-pattern multiplicity is normalized to zero because points outside
all generators do not affect the generated ideal. -/
structure BoundedProfile (K B : ℕ) where
  atom : Finset (Fin K) → Fin (B + 1)
  empty_zero : atom ∅ = 0
  load_le : ∀ i : Fin K, profileLoad atom i ≤ B

noncomputable instance (K B : ℕ) : Fintype (BoundedProfile K B) :=
  Fintype.ofInjective BoundedProfile.atom
    (fun ⟨_, _, _⟩ ⟨_, _, _⟩ h ↦ (BoundedProfile.mk.injEq ..).mpr h)

noncomputable instance (K B : ℕ) : DecidableEq (BoundedProfile K B) :=
  Classical.decEq _

/-- The natural-valued Venn multiplicities of a bounded profile. -/
def BoundedProfile.toNatProfile {K B : ℕ} (x : BoundedProfile K B) :
    Finset (Fin K) → ℕ :=
  atomMultiplicity x.atom

/-- Cardinality of the canonical ideal represented by a bounded profile. -/
noncomputable def BoundedProfile.value {K B : ℕ}
    (x : BoundedProfile K B) : ℕ :=
  (Section6.generatedIdealIdx Finset.univ
    (VennProfile.profileGenerator x.toNatProfile)).card

end AntichainOfGivenSize.ClusterLowerBound

/-! ## The quantity -/

namespace AntichainOfGivenSize.ClusterLowerBound

/-- Exact natural values represented by bounded `K`-profiles. -/
noncomputable def boundedValues (K B : ℕ) : Finset ℕ :=
  (Finset.univ : Finset (BoundedProfile K B)).image BoundedProfile.value

end AntichainOfGivenSize.ClusterLowerBound

namespace AntichainOfGivenSize.Paper

/-- The paper's ideal sizes with at most `K` nonempty-indexed generators,
each of size at most `B`. For `K > 0`, padding by repetition identifies this
with the exact-`K` bounded-profile image. The representation equivalence is
proved separately; this finite implementation includes no ambient-size cap. -/
noncomputable def attainableValues (B K : ℕ) : Finset ℕ :=
  ClusterLowerBound.boundedValues K B

end AntichainOfGivenSize.Paper
