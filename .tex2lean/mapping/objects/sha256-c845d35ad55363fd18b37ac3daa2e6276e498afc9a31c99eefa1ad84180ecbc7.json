        }
      ],
      "status": "active"
    },
    {
      "id": "claim-version:dd357164-2fdb-4515-9b40-b7fe4273c58c",
      "claimId": "claim:43c55239-e4a2-49f5-8856-60ed6dae84df",
      "targetVersionId": "target-version:8b5de558-8fd2-40d6-bfe5-69936f2cc0f4",
      "anchor": {
        "file": "paper/Generating_Antichains_Simplified.tex",
        "excerptDigest": "sha256-69abdd04b3817fbbd85bb6c868d475d4b85ef3128e307bbe56a5ace159135d78"
      },
      "text": "Each eligible family admits a structural header; there are at most (J+1)K^K possible headers.",
      "normalizedTextDigest": "sha256-ea729e2732fdade52db91593f8cfb68894c8e7b398b2ad9c269845c274e2a79b",
      "kind": "other",
