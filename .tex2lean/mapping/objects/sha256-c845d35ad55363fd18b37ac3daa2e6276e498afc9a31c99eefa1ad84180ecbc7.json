          "excerptDigest": "sha256-f03a03e6d69412082e662beed478607e89416249826466b89a3414036ae5abcd"
        }
      ],
      "status": "active"
    },
    {
      "id": "claim-version:a5046d34-cd50-4a2c-b39f-15d853bd654a",
      "claimId": "claim:580133b2-18ab-47b3-ba65-7d7b0c458f88",
      "targetVersionId": "target-version:8b5de558-8fd2-40d6-bfe5-69936f2cc0f4",
      "anchor": {
        "file": "paper/Generating_Antichains_Simplified.tex",
        "excerptDigest": "sha256-a2d5f4c3c3e2b4cfab84d072a64a57fbb71b9bc342d19de6ebb1c96f77a40d46"
      },
      "text": "Φ equals the complete signed inclusion–exclusion sum over nonempty queries.",
      "normalizedTextDigest": "sha256-40c64750656d01f962243019a9f1271a72d1469f861a48c7d24cb0285c90d8b4",
      "kind": "correctness",
      "evidence": [
