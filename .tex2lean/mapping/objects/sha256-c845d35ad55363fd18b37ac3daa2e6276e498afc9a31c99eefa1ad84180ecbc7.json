      "status": "active"
    },
    {
      "id": "claim-version:71fc944e-e00d-472e-8472-b6722d60f161",
      "claimId": "claim:774b3bc1-4135-4670-bd8a-6edd91a45509",
      "targetVersionId": "target-version:8b5de558-8fd2-40d6-bfe5-69936f2cc0f4",
      "anchor": {
        "file": "paper/Generating_Antichains_Simplified.tex",
        "excerptDigest": "sha256-3b1a5179a0f011d590cf87b8eeebb9a9d5b134035eb3e9b7b6b2f1dc572227ae"
      },
      "text": "The incidence record and central exponent transcript determine the exact signed central sum Z.",
      "normalizedTextDigest": "sha256-1f1b8f1af4aafb822faad0403b5a97c0f49d8bcd25761b62ff6942ce538f32bc",
      "kind": "correctness",
      "evidence": [
