  "claimVersions": [
    {
      "id": "claim-version:334ff530-6cc9-4274-9766-085a0b3a14a6",
      "claimId": "claim:2eae2c90-53c5-4f63-86b5-63a596cd0a3f",
      "targetVersionId": "target-version:8b5de558-8fd2-40d6-bfe5-69936f2cc0f4",
