    },
    {
      "id": "claim-version:02ef38da-9f7f-4a27-bf06-3b352b490ef3",
      "claimId": "claim:1ae6bfc0-31a0-49c8-a8c0-a95ff739ac61",
      "targetVersionId": "target-version:8b5de558-8fd2-40d6-bfe5-69936f2cc0f4",
      "anchor": {
        "file": "paper/Generating_Antichains_Simplified.tex",
        "excerptDigest": "sha256-7de3049944a2a38c2cc0940cc3cf45d8f4f3a3f732fb8169c236480c250515f2"
      },
      "text": "The exceptional set has size at most 2Kρ/λ^6 and cluster members agree off it.",
      "normalizedTextDigest": "sha256-aeab0c007638983dd49ce856476e038be9f9a1b309d3a79b3b4adc4a9209e055",
      "kind": "correctness",
      "evidence": [
