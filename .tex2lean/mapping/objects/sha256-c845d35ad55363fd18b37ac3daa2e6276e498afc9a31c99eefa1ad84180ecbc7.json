        }
      ],
      "status": "active"
    },
    {
      "id": "claim-version:63137d0b-bf46-41c0-b3e3-0df4633fbe08",
      "claimId": "claim:ba11b244-d5c4-403e-af70-6baa251dcb68",
      "targetVersionId": "target-version:8b5de558-8fd2-40d6-bfe5-69936f2cc0f4",
      "anchor": {
        "file": "paper/Generating_Antichains_Simplified.tex",
        "excerptDigest": "sha256-52e1ca563452a0d7f1aab59c6820da54ecb79b21e03fc963e50f7a8d985109dd"
      },
      "text": "There are at most (KB+1)2^(2K²ρ/λ⁶) incidence records and (B+1)^(2^J(1+K2^h)) central transcripts.",
      "normalizedTextDigest": "sha256-aa711be26f3ecc4254b879c02b950edfbb9ca17963cefc3a46121ea519d600dd",
      "kind": "other",
      "evidence": [
