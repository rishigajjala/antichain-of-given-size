  "obligations": [
    {
      "id": "obligation:c2e4f389-a027-4e4d-b217-bf27a0440b2d",
      "kind": "headline",
      "summary": "One absolute threshold works for every B above it and every K in the exact stated real-log budget, and |V(B,K)| ≤ 2^(B−√B).",
      "rationale": "The finalized blueprint assigns this paper claim to Model/Theorem.",
      "owner": "Model/Theorem",
      "status": "materialized"
    },
    {
      "id": "obligation:ec418bca-4374-4aa4-890d-98a98c93e1cb",
      "kind": "headline",
      "summary": "V(B,K) consists exactly of numerical ideal sizes from nonempty families of at most K generators of individual size at most B, with no ambient cap.",
      "rationale": "The finalized blueprint assigns this paper claim to Interface.",
      "owner": "Interface",
      "status": "planned"
    },
    {
      "id": "obligation:0fb831c3-6b46-47a2-9e21-8b77f958f23d",
      "kind": "headline",
      "summary": "Repeating a final generator and relabelling the active ground set preserve the ideal size and give N ≤ KB.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:af6fcb91-1d1b-4cf7-869a-965bb0d2847c",
      "kind": "headline",
      "summary": "Φ equals the complete signed inclusion–exclusion sum over nonempty queries.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:fc8b8a29-5f3d-4ed8-a565-16c555cab7ac",
      "kind": "headline",
      "summary": "Each eligible family admits a structural header; there are at most (J+1)K^K possible headers.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:01a891fc-e12d-461f-bee3-466dea5dab5a",
      "kind": "headline",
      "summary": "The exceptional set has size at most 2Kρ/λ^6 and cluster members agree off it.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:ea8de31f-5c80-4580-bc7d-915930bf928b",
      "kind": "headline",
      "summary": "The incidence record and central exponent transcript determine the exact signed central sum Z.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:a0f09070-388d-42b6-99d2-e6d09b457f72",
      "kind": "headline",
      "summary": "There are at most (KB+1)2^(2K²ρ/λ⁶) incidence records and (B+1)^(2^J(1+K2^h)) central transcripts.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:741c9fbb-d585-466a-b868-43513d3b1829",
      "kind": "headline",
      "summary": "Every noncentral exponent is at most B−ρ; the signed tail lies in an interval with at most 2^(B−ρ+K+2) integer values.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:4e838d21-9386-4fa5-a789-dec43559f6ad",
      "kind": "headline",
      "summary": "For each header the attainable-value count is bounded by the product of the incidence, transcript and tail-interval counts.",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:4966f7cb-704c-4633-8f61-2342aeb368d2",
      "kind": "headline",
      "summary": "Uniformly in admissible K, Γ≥2^(7λ/10), eventually d≤1/4 and L_rec≤Γ/2, and eventually Γ/4≥√B; summing over headers yields the stronger intermediate bound 2^(B−Γ/4).",
      "rationale": "The finalized blueprint assigns this paper claim to Analysis.",
      "owner": "Analysis",
      "status": "planned"
    },
    {
      "id": "obligation:f95b173a-07f4-455a-b354-5c991c193c79",
      "kind": "headline",
      "summary": "The existing endpoint proves the exact target with a different, larger clustered record encoding; identify reuse honestly and preserve the correspondence note.",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    },
    {
      "id": "obligation:17f558b0-1c3a-4d24-871e-be1588e9c770",
      "kind": "headline",
      "summary": "This target asserts no probabilistic or computational resource result; the following uniformly sampled dyadic corollary is separate.",
      "rationale": "The finalized blueprint assigns this paper claim to Handoff.",
      "owner": "Handoff",
      "status": "planned"
    }
  ],
