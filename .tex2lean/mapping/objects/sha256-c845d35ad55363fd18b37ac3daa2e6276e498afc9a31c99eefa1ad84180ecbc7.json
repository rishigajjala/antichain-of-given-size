    },
    {
      "id": "claim-version:b895d930-9612-4fb6-878c-f96e9ccf7112",
      "claimId": "claim:ed5fca89-7fec-42f9-b554-0ed2ef6e7863",
      "targetVersionId": "target-version:8b5de558-8fd2-40d6-bfe5-69936f2cc0f4",
      "anchor": {
        "file": "paper/Generating_Antichains_Simplified.tex",
        "excerptDigest": "sha256-e014e30b3070b2b108d4bd268c7f3645af283624e582a189f460feb17fa11e67"
      },
      "text": "Every noncentral exponent is at most B−ρ; the signed tail lies in an interval with at most 2^(B−ρ+K+2) integer values.",
      "normalizedTextDigest": "sha256-1e13cd23f8c4517b71c9dd4b9e02ea62fa447f6f127b8673cd5b3d390330dbee",
      "kind": "other",
      "evidence": [
